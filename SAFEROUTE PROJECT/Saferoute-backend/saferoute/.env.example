# Copy this file to .env and replace placeholders with local values.
# Never commit .env or real credentials.

# Flask environment: development | testing | production
FLASK_ENV=development

# Used to sign sessions/tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-unique-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Used by tests instead of DATABASE_URL, so tests never touch real data
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE_NAME

# Used only when creating local demo accounts in a fresh SQLite database
DEMO_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
DEMO_USER_PASSWORD=replace-with-a-strong-local-user-password

# External routing/map API (configured starting Phase 7)
ROUTING_API_KEY=replace-with-your-routing-api-key
ROUTING_API_URL=https://api.example-routing-provider.com

# Radius (km) used when matching hazards to a requested route
ROUTE_HAZARD_MATCH_RADIUS_KM=1.0
